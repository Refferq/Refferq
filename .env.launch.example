# Required for launch:env:strict
DATABASE_URL=postgresql://<user>:<pass>@<host>:5432/<db>?schema=public
JWT_SECRET=<generate-with-npm-run-launch:secrets>
NEXT_PUBLIC_APP_URL=https://<your-domain>
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@<your-domain>
TRACKING_ALLOWED_ORIGINS=https://<your-domain>,https://<other-origin>
WEBHOOK_SECRET=<generate-with-npm-run-launch:secrets>

# Optional helpers for staging dry run
STAGING_BASE_URL=https://<staging-domain>
STAGING_TRACKING_API_KEY=<tracking-key>
STAGING_REFERRAL_CODE=<affiliate-referral-code>
STAGING_ADMIN_USER_ID=<admin-user-id>
STAGING_ADMIN_AUTH_TOKEN=<admin-auth-token>
STAGING_ADMIN_EMAIL=<admin-email>
STAGING_ADMIN_PASSWORD=<admin-password>
